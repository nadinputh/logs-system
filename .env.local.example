# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/logs-system?retryWrites=true&w=majority

# App server
PORT=4000

# NextAuth
NEXTAUTH_SECRET=replace-with-a-random-32-char-secret
NEXTAUTH_URL=http://localhost:$PORT

# Cloudinary (public env vars for direct browser upload)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=logs-system-selfies

# Cron protection
CRON_SECRET=replace-with-a-random-secret

# SMTP (account registration: verification, set-password, and invite emails)
#
# ALL THREE of SMTP_HOST, SMTP_USER and SMTP_PASS are required together.
# If any one of them is missing, nothing is sent:
#   - in development, the message is printed to the server console instead
#   - in production, an error is logged and the mail is dropped
# Setting SMTP_HOST alone does NOT turn sending on.
#
# Left commented out on purpose. Uncommenting these with the placeholder values
# below satisfies the all-three check, so the app would build a real transport
# to a host that does not answer and stall each signup for ten seconds before
# giving up — instead of using the console fallback you actually want in dev.
# Fill in real values before uncommenting.
#
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# EMAIL_FROM="Kamnotheat <no-reply@yourdomain.com>"
#
# Deliverability: transactional mail from an unauthenticated domain lands in
# spam. Publish SPF, DKIM and DMARC records for whatever domain EMAIL_FROM uses.

# Stripe (paid team plans — checkout, billing portal, webhooks)
#
# BOTH STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are required together.
# Without them, checkout/portal routes return a clear "billing not configured"
# error instead of throwing, and the plan catalog (npm run seed:plans) still
# seeds fine with stripePriceId left unset.
#
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# Dev-mode billing bypass — lets you exercise the full checkout → payment →
# callback → invoice lifecycle with NO Stripe keys and no network access.
# Ignored (never activates) unless NODE_ENV is not "production" — see
# mockBillingEnabled() in lib/billing/provider.ts. Leave unset to use real
# Stripe (or leave billing unconfigured) in dev instead.
# BILLING_MOCK_MODE=true
